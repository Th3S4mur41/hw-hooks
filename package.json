{
	"name": "hw-hooks",
	"version": "2.0.0-alpha.7",
	"description": "A tool to synchronize data from HomeWizard to EnergyID",
	"keywords": [
		"homewizard",
		"homewizard-energy",
		"homewizard-p1-meter",
		"energyid",
		"sync",
		"api",
		"webhook"
	],
	"author": "Michaël Vanderheyden <hello@th3s4mur41.me> (https://th3s4mur41.me)",
	"license": "MIT",
	"homepage": "https://github.com/Th3S4mur41/hw-hooks",
	"funding": "https://github.com/sponsors/Th3S4mur41",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Th3S4mur41/hw-hooks.git"
	},
	"bugs": {
		"url": "https://github.com/Th3S4mur41/hw-hooks/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "index.mjs",
	"files": [
		"bin/",
		"index.mjs"
	],
	"bin": {
		"hw-hooks": "bin/cli.mjs"
	},
	"scripts": {
		"clean": "npx rimraf dist bin coverage && git clean -Xf",
		"dev": "npm run build:cli -- --watch",
		"build": "npm run build:cli && npm run build:docker",
		"build:cli": "node esbuild.config.mjs",
		"build:docker": "docker build --tag hw-hooks .",
		"lint": "biome ci . && prettier --check --ignore-unknown --no-error-on-unmatched-pattern .",
		"lint:fix": "biome check --write . && prettier --write --ignore-unknown --no-error-on-unmatched-pattern .",
		"prepare": "husky",
		"release": "semantic-release",
		"postversion": "npm run lint:fix",
		"test": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@codedependant/semantic-release-docker": "^8.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@vitest/coverage-v8": "^2.1.1",
		"esbuild": "^0.24.0",
		"husky": "^9.0.5",
		"lint-staged": "^17.0.2",
		"prettier": "^3.0.0",
		"semantic-release": "^25.0.0",
		"vitest": "^2.1.1"
	},
	"dependencies": {
		"yargs": "^18.0.0"
	},
	"overrides": {
		"conventional-changelog-conventionalcommits": ">= 8.0.0"
	}
}
